<Project Sdk="Microsoft.NET.Sdk">
  <!-- The notch rebuilt on WinUI 3 + Composition (docs/superpowers/specs/2026-11-06-winui-notch-design.md).
       Part 1: shell, hover, shadow, click-through, closed state and the media page. Started by hand next to the
       WPF notch; it reads the WPF settings.json and never writes it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VNotch.WinUI</AssemblyName>
    <RootNamespace>VNotch.WinUI</RootNamespace>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>..\logo.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Fonts\SF-Pro-Display-*.otf" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shared native core (built by the WPF project): palette, brightness and blur code of the media page. -->
    <Content Include="..\Native\out\VNotch.Native.dll" Link="VNotch.Native.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
